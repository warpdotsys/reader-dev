pub fn probe_source(bs: &BookSource) -> SearchRule {
    bs.get_search_rule()
}

pub fn probe_logger(bs: &BookSource) {
    if let Some(lg) = bs.get_logger() {
        let _ = lg;
    }
}

pub fn probe_router(router: &mut crate::stubs::io::vertx::Router) {
    router.route_with_path("/x").global_handler(&|it| {
        let _check: &RoutingContext = it;
        let _same: &crate::stubs::io::vertx::RoutingContext = it;
    });
}
