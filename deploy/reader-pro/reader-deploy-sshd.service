[Unit]
Description=Dedicated SSH listener for Reader Pro deployments
After=network.target
ConditionPathExists=!/etc/ssh/sshd_not_to_be_run

[Service]
Type=simple
EnvironmentFile=-/etc/default/ssh
ExecStartPre=/usr/sbin/sshd -t
ExecStart=/usr/sbin/sshd -D $SSHD_OPTS -o Port=22222 -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no -o PermitRootLogin=prohibit-password -o MaxAuthTries=3 -o PidFile=/run/sshd-reader-deploy.pid
KillMode=process
Restart=on-failure
RestartPreventExitStatus=255

[Install]
WantedBy=multi-user.target
